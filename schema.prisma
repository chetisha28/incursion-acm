// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USERS & ROLE-BASED ACCESS CONTROL
enum Role {
  MEMBER
  CLUB_EXECUTIVE
  ACM_CORE_VERIFIER
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  organizedEvents Event[] @relation("EventOrganizer")
  verifiedEvents  Event[] @relation("EventVerifier")
  expenses        Expense[]
}

// 2. EVENTS MODULE (Centralized Calendar & Conflict Detection)
enum EventStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Event {
  id              String      @id @default(uuid())
  title           String
  description     String?
  eventType       String      // e.g., "Technical Workshop", "Hackathon"
  venue           String      // Crucial for conflict detection
  targetAudience  String      // e.g., "1st Year B.Tech CSE"
  startTime       DateTime    // Conflict checking range start
  endTime         DateTime    // Conflict checking range end
  status          EventStatus @default(PENDING)
  
  // Foreign Key: Who submitted the event
  organizerId     String
  organizer       User        @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  // Foreign Key: Which core verifier approved/rejected it
  verifierId      String?
  verifier        User?       @relation("EventVerifier", fields: [verifierId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  expenses        Expense[]
}

// 3. EXPENSE & FUND MANAGEMENT MODULE
model Expense {
  id          String   @id @default(uuid())
  amount      Float
  category    String   // e.g., "Logistics", "Food", "Marketing"
  description String?
  receiptUrl  String?  // Storage link for bills/receipts
  date        DateTime @default(now())

  // Foreign Key: Associated Event (Optional)
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Foreign Key: Who logged the expense
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. INSTITUTIONAL MEMORY / SYSTEM LOGS
model SystemLog {
  id          String   @id @default(uuid())
  action      String   // e.g., "EVENT_CREATED", "CONFLICT_DETECTED"
  details     String
  timestamp   DateTime @default(now())
}