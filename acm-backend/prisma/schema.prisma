generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  VIEWER
  EXECUTIVE
  CORE
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum BudgetPeriod {
  MONTHLY
  SEMESTER
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  passwordHash       String
  role               Role
  title              String?
  department         String?
  mustChangePassword Boolean          @default(false)
  isActive           Boolean          @default(true)
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           AuthSession[]
  createdEvents      Event[]          @relation("EventCreator")
  assignedEvents     Event[]          @relation("AssignedEvents")
  createdExpenses    Expense[]        @relation("ExpenseCreator")
  createdBudgets     Budget[]         @relation("BudgetCreator")
  resolvedEvents     Event[]          @relation("EventResolver")
  eventUpvotes       EventUpvote[]
  activityLogs       ActivityLog[]
  createdWork        WorkAssignment[] @relation("CreatedWork")
  assignedWork       WorkAssignment[] @relation("AssignedWork")
  createdByAdmin     User?            @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]           @relation("UserHierarchy")

  @@index([role, isActive])
  @@index([createdById])
}

model AuthSession {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Event {
  id                String           @id @default(cuid())
  title             String
  description       String           @db.Text
  category          String
  startsAt          DateTime
  endsAt            DateTime
  timezone          String           @default("UTC")
  venue             String
  expectedAudience  String
  organizer         String
  campusRelevant    Boolean          @default(false)
  status            EventStatus      @default(DRAFT)
  createdById       String
  assignedToId      String?
  archivedAt        DateTime?
  resolvedAt        DateTime?
  resolvedById      String?
  resolutionNotes   String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         User             @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo        User?            @relation("AssignedEvents", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolver          User?            @relation("EventResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  expenses          Expense[]
  upvotes           EventUpvote[]
  assignments       WorkAssignment[]

  @@index([status, startsAt, endsAt])
  @@index([category, startsAt])
  @@index([createdById])
  @@index([assignedToId])
  @@index([resolvedById])
}

model Expense {
  id              String    @id @default(cuid())
  amount          Decimal   @db.Decimal(12, 2)
  category        String
  transactionDate DateTime
  description     String    @db.Text
  eventId         String?
  receiptUrl      String?
  createdById     String
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  event           Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy       User      @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([transactionDate, category])
  @@index([eventId])
  @@index([createdById])
}

model Budget {
  id          String       @id @default(cuid())
  name        String
  period      BudgetPeriod
  startsAt    DateTime
  endsAt      DateTime
  totalAmount Decimal      @db.Decimal(12, 2)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User         @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([name, startsAt, endsAt])
  @@index([period, startsAt, endsAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model EventUpvote {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model WorkAssignment {
  id          String             @id @default(cuid())
  title       String
  description String?            @db.Text
  status      AssignmentStatus   @default(PENDING)
  priority    AssignmentPriority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String
  assignerId  String
  eventId     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  assignee    User               @relation("AssignedWork", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigner    User               @relation("CreatedWork", fields: [assignerId], references: [id], onDelete: Restrict)
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([assignerId])
  @@index([eventId])
}
